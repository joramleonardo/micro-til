# Micro-TIL Configuration for Hostinger
# Copy this to .env on your Hostinger server

# GitHub Personal Access Token (Fine-grained or classic with 'repo' scope)
GITHUB_TOKEN=github_pat_your_token_here

# GitHub Username & Target Repository
GITHUB_USERNAME=your-github-username
GITHUB_REPO=til
GITHUB_BRANCH=main

# File Strategy: 'single' (appends to GITHUB_FILE_PATH) or 'daily' (creates til/YYYY-MM-DD.md)
COMMIT_STRATEGY=single
GITHUB_FILE_PATH=TIL.md

# Optional Security PIN (e.g. 1234)
# If set, anyone visiting your Hostinger URL must enter this PIN to commit.
# Keeps your web app private on the public internet!
APP_PIN=1234
